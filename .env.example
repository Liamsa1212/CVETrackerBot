# ==========================================
# CVE Tracker Bot Environment Configuration
# ==========================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: NVD API Key (significantly raises rate limits from 5 req/30s to 50 req/30s)
NVD_API_KEY=

# Optional: GitHub Personal Access Token (for GHSA queries; avoids 60 req/hr anonymous limit)
GITHUB_TOKEN=

# Database Connection (Async SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///data/cve_tracker.db

# Polling Interval in seconds (default: 3600 = 1 hour)
POLL_INTERVAL_SECONDS=3600

# Minimum CVSS Score to store/track globally (0.0 to 10.0, default 6.0)
DEFAULT_MIN_CVSS=6.0

# Optional: Default Discord Webhook URL for global broadcasts
DISCORD_WEBHOOK_URL=

# Optional: Default Generic Webhook URL
GENERIC_WEBHOOK_URL=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable JSON logging (useful for container stdout / Datadog / CloudWatch)
LOG_JSON=false
